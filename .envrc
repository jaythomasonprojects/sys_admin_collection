source .venv/bin/activate || return

export ANSIBLE_CONFIG="$PWD/ansible.cfg"
export ANSIBLE_HOME="$PWD/.cache/molecule"
export MOLECULE_GLOB='extensions/molecule/**/molecule.yml'
development_namespace="$PWD/.ansible/development/ansible_collections/jaythomasonprojects"
mkdir -p "$development_namespace"
if [ -L "$development_namespace/sys_admin" ] &&
    [ "$development_namespace/sys_admin" -ef "$PWD" ]; then
    :
elif [ -e "$development_namespace/sys_admin" ] || [ -L "$development_namespace/sys_admin" ]; then
    echo 'Development collection path is occupied; left untouched.' >&2
    return 1
else
    ln -s "$PWD" "$development_namespace/sys_admin"
fi
unset development_namespace
export ANSIBLE_COLLECTIONS_PATH="$PWD/.ansible/development:$PWD/.ansible/collections"
export ANSIBLE_COLLECTIONS_SCAN_SYS_PATH=false
# Direct lint also imports the native driver's guest-agent module.
export ANSIBLE_LIBRARY="$(python -c 'import molecule_proxmox as m; print(m.__path__[0] + "/modules")')"

mkdir -p "$ANSIBLE_HOME"
chmod 700 "$ANSIBLE_HOME"
