{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: worktree",
      "type": "shell",
      "command": "uv run --no-project scripts/setup_worktree.py",
      "problemMatcher": []
    },
    {
      "label": "Lint: check",
      "type": "shell",
      "command": ".venv/bin/ansible-lint .",
      "problemMatcher": []
    },
    {
      "label": "Lint: format",
      "type": "shell",
      "command": ".venv/bin/yamllint .",
      "problemMatcher": []
    },
    {
      "label": "Lint: fix",
      "type": "shell",
      "command": ".venv/bin/ansible-lint . --fix",
      "problemMatcher": []
    },
    {
      "label": "Test: all",
      "type": "shell",
      "command": ".venv/bin/molecule test --all",
      "options": {
        "env": {
          "ANSIBLE_CONFIG": "ansible.cfg",
          "MOLECULE_GLOB": "extensions/molecule/**/molecule.yml",
          "PATH": "${workspaceFolder}/.venv/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Galaxy: build",
      "type": "shell",
      "command": ".venv/bin/ansible-galaxy collection build --force --output-path dist",
      "problemMatcher": []
    },
    {
      "label": "Galaxy: publish",
      "type": "shell",
      "command": "version=$(sed -n \"s/^version: '\\(.*\\)'/\\1/p\" galaxy.yml) && .venv/bin/ansible-galaxy collection publish \"dist/jaythomasonprojects-sys_admin-${version}.tar.gz\" --token \"$(tr -d '\\n' < ~/.ansible/galaxy_token)\"",
      "detail": "Publish the existing versioned archive only after installing it and passing the full release gate. This task does not rebuild it.",
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": ["-c"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Clean: caches",
      "type": "shell",
      "command": "find . -type d \\( -name .venv -o -name .ansible -o -name .cache -o -name openspec \\) -prune -o -type d \\( -name __pycache__ -o -name .ruff_cache -o -name .pytest_cache \\) -exec rm -rf {} +",
      "problemMatcher": []
    }
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  }
}
