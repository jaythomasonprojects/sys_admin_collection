{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: worktree",
      "type": "shell",
      "command": "uv run --no-project scripts/setup_worktree.py",
      "problemMatcher": []
    },
    {
      "label": "Lint: check",
      "type": "shell",
      "command": "source .envrc && ansible-lint --offline .",
      "problemMatcher": []
    },
    {
      "label": "Lint: format",
      "type": "shell",
      "command": "source .envrc && yamllint .",
      "problemMatcher": []
    },
    {
      "label": "Lint: fix",
      "type": "shell",
      "command": "source .envrc && ansible-lint --offline . --fix",
      "problemMatcher": []
    },
    {
      "label": "Lint: Python",
      "type": "shell",
      "command": "uvx ruff check scripts",
      "problemMatcher": []
    },
    {
      "label": "Type: check",
      "type": "shell",
      "command": "uvx pyright",
      "problemMatcher": []
    },
    {
      "label": "Test: all",
      "type": "shell",
      "command": "source .envrc && version=$(sed -n \"s/^version: '\\(.*\\)'/\\1/p\" galaxy.yml) && candidate=\"$PWD/dist/jaythomasonprojects-sys_admin-${version}.tar.gz\" && export ANSIBLE_COLLECTIONS_PATH=\"$PWD/.ansible/collections\" && cmp <(tar -xOf \"$candidate\" FILES.json) .ansible/collections/ansible_collections/jaythomasonprojects/sys_admin/FILES.json && ansible-galaxy collection verify jaythomasonprojects.sys_admin --offline && molecule -vv test --all",
      "detail": "Release gate against the existing versioned archive installation only. Build and install first; verify exact contents, then run all scenarios sequentially. The development link is excluded.",
      "problemMatcher": []
    },
    {
      "label": "Test: auto_updates/linux",
      "type": "shell",
      "command": "source .envrc && molecule test -s auto_updates/linux",
      "problemMatcher": []
    },
    {
      "label": "Test: install_app/linux",
      "type": "shell",
      "command": "source .envrc && molecule test -s install_app/linux",
      "problemMatcher": []
    },
    {
      "label": "Test: install_app/windows",
      "type": "shell",
      "command": "source .envrc && molecule test -s install_app/windows",
      "problemMatcher": []
    },
    {
      "label": "Test: ssh/linux",
      "type": "shell",
      "command": "source .envrc && molecule test -s ssh/linux",
      "problemMatcher": []
    },
    {
      "label": "Test: ssh/windows",
      "type": "shell",
      "command": "source .envrc && molecule test -s ssh/windows",
      "problemMatcher": []
    },
    {
      "label": "Test: time_sync/linux",
      "type": "shell",
      "command": "source .envrc && molecule test -s time_sync/linux",
      "problemMatcher": []
    },
    {
      "label": "Galaxy: build",
      "type": "shell",
      "command": ".venv/bin/ansible-galaxy collection build --force --output-path dist",
      "problemMatcher": []
    },
    {
      "label": "Galaxy: publish",
      "type": "shell",
      "command": "version=$(sed -n \"s/^version: '\\(.*\\)'/\\1/p\" galaxy.yml) && .venv/bin/ansible-galaxy collection publish \"dist/jaythomasonprojects-sys_admin-${version}.tar.gz\" --token \"$(tr -d '\\n' < ~/.ansible/galaxy_token)\"",
      "detail": "Publish the existing versioned archive only after installing it and passing the full release gate. This task does not rebuild it.",
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": ["-c"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Clean: caches",
      "type": "shell",
      "command": "find . -type d \\( -name .venv -o -name .ansible -o -name .cache -o -name openspec \\) -prune -o -type d \\( -name __pycache__ -o -name .ruff_cache -o -name .pytest_cache \\) -exec rm -rf {} +",
      "problemMatcher": []
    }
  ],
  "options": {
    "cwd": "${workspaceFolder}",
    "shell": {
      "executable": "/bin/bash",
      "args": ["-c"]
    }
  }
}
